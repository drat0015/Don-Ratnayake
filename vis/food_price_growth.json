{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 300,
  "title": "Food Price Growth by Category",
  "data": {"url": "data/cleaned/food_price_growth.csv"},
  "mark": {
    "type": "circle",
    "size": 180
  },
  "encoding": {
    "x": {
      "field": "Growth",
      "type": "quantitative",
      "title": "Price Growth (%)"
    },
    "y": {
      "field": "Category",
      "type": "nominal",
      "sort": "-x",
      "title": "Food Category"
    },
    "color": {
      "field": "Growth",
      "type": "quantitative",
      "scale": {"scheme": "oranges"},
      "legend": null
    },
    "tooltip": [
      {"field": "Category", "type": "nominal"},
      {"field": "Growth", "type": "quantitative", "title": "Growth (%)"}
    ]
  }
}