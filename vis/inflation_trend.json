{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 300,
  "title": "CPI Trend in Australia",
  "data": {
    "url": "data/cleaned/inflation_trend.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Month"
    },
    "y": {
      "field": "CPI",
      "type": "quantitative",
      "title": "CPI Index"
    },
    "tooltip": [
      {"field": "Date", "type": "temporal", "title": "Month"},
      {"field": "CPI", "type": "quantitative", "title": "CPI"}
    ]
  }
}